{
  "name": "react-native-pear-end",
  "version": "0.1.0-beta.1",
  "description": "Reusable Bare-on-React-Native integration — embed a Pear-style backend (corestore + hypercore + hyperswarm + hyperdht + autobase) inside a React Native app, with native UDP via UDX.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worklet": {
      "default": "./worklet/index.mjs"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    }
  },
  "bin": {
    "pear-end-pack": "./bin/pear-end-pack.js"
  },
  "files": [
    "dist/",
    "src/",
    "worklet/",
    "bin/",
    "patches/",
    "tsconfig.json",
    "README.md",
    "ARCHITECTURE.md",
    "TROUBLESHOOTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/unit/*.test.mjs",
    "test:fast": "node --test test/unit/*.test.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react-native": ">=0.72.0",
    "react-native-bare-kit": "^0.14.0",
    "bare-pack": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigdestiny2/react-native-pear-end"
  },
  "keywords": [
    "react-native",
    "bare",
    "pear",
    "hypercore",
    "hyperswarm",
    "hyperdht",
    "p2p",
    "mobile",
    "android",
    "ios"
  ]
}
